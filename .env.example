# Copy to .env to change local settings. .env is ignored by Git.
# Variables already set in the shell take precedence over this file.

# Port for the local server (it always binds to 127.0.0.1 only).
PORT=4174

# Private folder for saved projects, revisions and backups. Defaults to ./.local-data.
# FORMA_DATA=/absolute/path/to/private/folder
